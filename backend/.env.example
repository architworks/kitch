# Structured persistence. Supabase remains the default when this is omitted.
KITCH_DATABASE_BACKEND=supabase
# For a local installation instead use:
# KITCH_DATABASE_BACKEND=sqlite
# KITCH_SQLITE_PATH=.kitch/kitch.sqlite3

# Supabase persistence (required only when the selected backend is supabase)
SUPABASE_URL=your-supabase-project-url
# Preferred trusted-backend credential (never expose it to the frontend)
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key
# Temporary legacy alternative; do not set both:
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt

# Gemini model used by every Kitch agent and the ADK event compactor
KITCH_LLM_MODEL=gemini-3.6-flash

# Gemini inference for local development and the current Vercel deployment.
# This authentication choice is independent from Memory Bank below.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Household preference memory. Use in_memory only for tests or optional local
# development. Standard Vertex mode uses Application Default Credentials
# locally and Vercel OIDC federation in production; it does not use an API key.
KITCH_MEMORY_SERVICE=in_memory
# KITCH_MEMORY_BANK_ID=your-reasoning-engine-id
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=global
# Vercel production only:
# GCP_PROJECT_NUMBER=your-numeric-google-cloud-project-number
# GCP_SERVICE_ACCOUNT_EMAIL=kitch-service-account@your-project.iam.gserviceaccount.com
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-kitch

# Optional Zepto integration
ZEPTO_MCP_ENABLED=false

# Provider credential vault for hosted/Supabase deployments. Local SQLite
# installations create and retain an ignored .kitch/provider-credentials.key.
# Generate a hosted key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# Swiggy Instamart delegated OAuth + MCP
SWIGGY_INSTAMART_ENABLED=false
SWIGGY_INSTAMART_ENV=local
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_OAUTH_BASE_URL=https://mcp.swiggy.com
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8000/api/grocery/providers/swiggy_instamart/oauth/callback
SWIGGY_OAUTH_SCOPE=mcp:tools
SWIGGY_OAUTH_CLIENT_NAME=Kitch
# Production only, after Swiggy approval and the staging soak:
SWIGGY_INSTAMART_PRODUCTION_APPROVED=false

# Browser origin used after a successful provider OAuth callback
FRONTEND_URL=http://localhost:3000
